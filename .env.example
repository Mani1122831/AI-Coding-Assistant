# AI Coding Assistant - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# ── AI Provider ─────────────────────────────────────
AI_PROVIDER=gemini

# ── Model Selection ──────────────────────────────────
# Supported Gemini models: gemini-flash-latest (default), gemini-3.8-flash, gemini-3.5-flash-lite, gemini-3.1-pro-preview
GEMINI_MODEL=gemini-flash-latest

# ── API Key ──────────────────────────────────────────
# Get your Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── MongoDB Persistence ──────────────────────────────
# MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=
MONGODB_DATABASE=ai_coding_assistant

# ── File Upload Settings ─────────────────────────────
MAX_FILE_SIZE_MB=2

# ── Logging ──────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Application Environment & URLs ───────────────────
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8501
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# ── SMTP Email Delivery ──────────────────────────────
# Configurable SMTP settings for secure password reset delivery
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

